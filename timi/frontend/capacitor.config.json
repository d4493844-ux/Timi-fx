{
  "appId": "com.timi.trading",
  "appName": "TIMI",
  "webDir": "build",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "*.supabase.co",
      "*.binaryws.com", 
      "*.deriv.com",
      "*.firebase.com",
      "*.googleapis.com"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true,
    "loggingBehavior": "debug"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "backgroundColor": "#020810",
      "showSpinner": false,
      "launchAutoHide": true
    },
    "Preferences": {
      "group": "timi"
    }
  }
}
